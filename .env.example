# ---------------------------------------------------------------------------
# Local development. Never commit this file.
# ---------------------------------------------------------------------------

# PostgreSQL 17 is already running on this machine (service postgresql-x64-17).
# Replace YOUR_PASSWORD below with the password you set when installing it.
# `npm run db:migrate` creates the niya_admin database if it does not exist.
#
# For production use a managed Postgres in ap-south-1 (Mumbai) - a us-east-1
# database adds ~200ms to every query for an operator in India. On a serverless
# host put the POOLED url here and the direct one in DIRECT_DATABASE_URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/niya_admin?schema=public"

# Auth.js. Rotate this in production; changing it invalidates all sessions.
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Seeder controls
SEED_ADMIN_EMAIL="admin@niyabags.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_OPENING_STOCK=12
# Sample orders/customers so the dashboard has something to render.
# Set to false for a truthful empty store.
SEED_DEMO_ORDERS=true

# Where the storefront lives. Used to render legacy /products/... image paths,
# which are served by the storefront's own /public folder, not by the admin.
NEXT_PUBLIC_STOREFRONT_ORIGIN="http://localhost:5173"
