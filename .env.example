# ---------------------------------------------------------------------------
# Local development. Never commit this file.
# ---------------------------------------------------------------------------

# PostgreSQL 18 on this machine. `npm run db:reset` creates diybaazar_db,
# applies the init migration and runs the seed. The old niyabags_db database
# is left untouched.
#
# For production use a managed Postgres in ap-south-1 (Mumbai). On a
# serverless host put the POOLED url here and the direct one in
# DIRECT_DATABASE_URL.
DATABASE_URL="postgresql://postgres:1234567890@localhost:5432/diybaazar_db?schema=public"

# Auth.js. Rotate this in production; changing it invalidates all sessions.
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Where THIS app is served. Used for CSRF origin checks on /api/admin writes
# and for password-reset links (D8, D10).
APP_ORIGIN=http://localhost:3000

# Storefront (customer website) origins allowed by CORS, comma-separated (D7).
STOREFRONT_ORIGINS=http://localhost:5173
NEXT_PUBLIC_STOREFRONT_ORIGIN="http://localhost:5173"
# Shared secret the website sends as X-Storefront-Key to /api/v1/integration (E7).
STOREFRONT_API_KEY="generate-with: openssl rand -hex 24"

# Encryption at rest for 2FA secrets, bank accounts, provider credentials (D4).
# 32 random bytes, base64. Production refuses to start if missing or equal to
# AUTH_SECRET.
ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# Header value for POST /api/internal/jobs/run (>= 32 bytes, D8).
CRON_SECRET="generate-with: openssl rand -hex 32"

# Storage driver: local | s3 (D11, D6). Local writes under STORAGE_LOCAL_DIR/
# {public,private}, never under public/.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Number of reverse proxies in front of the app, for clientIp() (D9).
TRUSTED_PROXY_HOPS=0

# Seeder controls
SEED_ADMIN_EMAIL="admin@diybaazar.local"
SEED_ADMIN_PASSWORD="Admin@123456"
# Demo sellers/products/orders (wave 2b). false = a truthful empty store.
SEED_DEMO_DATA=true
